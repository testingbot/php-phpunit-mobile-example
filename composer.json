{
  "require": {
    "php": ">=8.2",
    "php-webdriver/webdriver": "^1.15",
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "android_single": [
      "@putenv CONFIG_FILE=config/android/single.conf.json",
      "phpunit tests/android"
    ],
    "ios_single": [
      "@putenv CONFIG_FILE=config/ios/single.conf.json",
      "phpunit tests/ios"
    ],
    "android_parallel": "@php lib/parallel.php config/android/parallel.conf.json tests/android",
    "ios_parallel": "@php lib/parallel.php config/ios/parallel.conf.json tests/ios"
  },
  "autoload": {
    "classmap": ["lib/"]
  }
}
